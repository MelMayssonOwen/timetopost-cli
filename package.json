{
  "name": "timetopost",
  "version": "0.1.1",
  "description": "Command line for TimeToPost: log in, list connected accounts, create drafts, schedule posts and approve drafts from your terminal or scripts.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://timetopost.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MelMayssonOwen/timetopost-cli.git"
  },
  "keywords": [
    "timetopost",
    "cli",
    "social-media",
    "scheduler",
    "drafts",
    "automation"
  ],
  "bin": {
    "timetopost": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
