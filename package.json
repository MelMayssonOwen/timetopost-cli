    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.6.0"
  },
  "bugs": {
    "url": "https://github.com/MelMayssonOwen/timetopost-cli/issues"
  }
